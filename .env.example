# ========================================================
# AI Code Reviewer - Environment Configuration
# ========================================================
# Note: Google Gemini API Key and GitHub/GitLab tokens are
# configured securely at runtime via the web UI settings screen.
# They are encrypted at rest using AES-256-GCM.

# Server Port
PORT=8080

# SQLite Database File Path
DB_PATH=./reviewer.db

# 32-byte Encryption Key (Hex-encoded 64 characters)
# Generate your unique key using: openssl rand -hex 32
ENCRYPTION_KEY=your_64_character_hex_encryption_key_here

# Frontend URL for CORS
CORS_ORIGIN=http://localhost:3000

# Frontend Next.js Public Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8080/api
