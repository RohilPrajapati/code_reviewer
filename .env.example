# ========================================================
# AI Code Reviewer - Environment Configuration
# ========================================================
# Note: Google Gemini API Key and GitHub/GitLab tokens are
# configured securely at runtime via the web UI settings screen.
# They are encrypted at rest using AES-256-GCM.

# Server Port
PORT=8080

# SQLite Database File Path
DB_PATH=./reviewer.db

# 32-byte Encryption Key (Hex-encoded 64 characters or 32 characters string)
# You can generate a random 32-byte key using: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Frontend URL for CORS
CORS_ORIGIN=http://localhost:3000

# Frontend Next.js Public Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8080/api
